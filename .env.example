# ─── Application ───
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=https://campusconnect.app

# ─── Database ───
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=campusconnect
DB_PASSWORD=<strong-random-password>
DB_DATABASE=campusconnect

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-random-password>

# ─── JWT ───
JWT_ACCESS_SECRET=<512-bit-random-hex>
JWT_REFRESH_SECRET=<512-bit-random-hex>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=CampusConnect

# ─── OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://campusconnect.app/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://campusconnect.app/api/v1/auth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=https://campusconnect.app/api/v1/auth/microsoft/callback

# ─── Email (SMTP) ───
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<sendgrid-api-key>
SMTP_FROM=noreply@campusconnect.app

# ─── Storage (S3-compatible) ───
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=campusconnect-uploads
S3_PUBLIC_URL=https://cdn.campusconnect.app

# ─── Security ───
ENCRYPTION_KEY=<256-bit-random-hex>
HMAC_SECRET=<512-bit-random-hex>
TOTP_ISSUER=CampusConnect
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─── Session ───
SESSION_EXPIRY_HOURS=24
MAX_DEVICES=5
LOGIN_ATTEMPTS_MAX=5
LOGIN_ATTEMPTS_WINDOW_MIN=15

# ─── Monitoring ───
SENTRY_DSN=
DATADOG_API_KEY=
